# Top Dog — environment variables
# Copy to .env and fill in real values. The real .env is gitignored.
# Local values are printed by `supabase start`; hosted values come from the
# Supabase dashboard (Settings -> API).

# ---- Browser-exposed (PUBLIC_ prefix REQUIRED to reach the client) ----
# Supabase API URL (local: http://127.0.0.1:54321)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Publishable key (sb_publishable_...). Legacy anon keys deprecate end-2026.
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# ---- Server-only (NEVER prefix with PUBLIC_, never expose to browser) ----
# Secret key (sb_secret_...). Used only in $lib/server code.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
